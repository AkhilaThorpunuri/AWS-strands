# Copy this file to `settings.config` in the repo root and fill in ONE provider.
# `settings.config` is git-ignored so your keys never get committed.

# --- Option 1: Amazon Bedrock (uses your AWS CLI / boto3 credentials by default) ---
AWS_REGION='us-east-1'
BEDROCK_MODEL_ID='us.amazon.nova-pro-v1:0'

# --- Option 2: NVIDIA NIM (free tier at https://build.nvidia.com, OpenAI-compatible) ---
# NVIDIA_API_KEY='nvapi-...'
# NVIDIA_MODEL='nvidia/nemotron-3-super-120b-a12b'

# --- Option 3: OpenAI ---
# OPENAI_API_KEY='sk-...'
# OPENAI_MODEL='gpt-4o-mini'

# --- Option 4: Local Ollama (run `ollama serve` first) ---
# OLLAMA_HOST='http://localhost:11434'
# OLLAMA_MODEL='llama3.2'

